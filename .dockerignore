# Keep build context lean.
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/
**/.env
**/.env.*
!**/.env.example

# Frontend build artifacts
frontend/node_modules/
frontend/.next/
frontend/out/

# Repo housekeeping
.git/
.github/
.idea/
.vscode/
**/.DS_Store

# Local data + model weights (must not bake into image)
data/
backend/data/
*.npy
*.pth
*.pt
*.bin
*.safetensors

# ImageBind sub-repo bookkeeping
backend/ImageBind/.git/
backend/ImageBind/.assets/

# Docs + plans (not needed at runtime)
SYNAPSE_PLAN.md
README.md
docs/
