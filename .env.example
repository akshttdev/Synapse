# Synapse — environment template.
# Copy to `.env` (project root) and fill values. Never commit `.env`.

# ── App ─────────────────────────────────────────────────────────────
PROJECT_NAME=Synapse
VERSION=1.0.0
API_V1_PREFIX=/api/v1

# ── Qdrant ──────────────────────────────────────────────────────────
# Local docker default points to the in-cluster service.
# For Qdrant Cloud, set QDRANT_URL=https://<cluster>.qdrant.io and QDRANT_API_KEY.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=synapse

# ── Redis ───────────────────────────────────────────────────────────
# Local docker default. For Upstash use redis://default:<token>@<host>:6379.
REDIS_URL=redis://redis:6379/0
REDIS_REST_URL=
REDIS_REST_TOKEN=
CACHE_TTL=3600

# ── Object storage (S3-compatible: AWS S3 / Cloudflare R2 / Oracle / MinIO) ──
# These map to the provider's "access key" / "secret key" pair.
#   Oracle: User Settings → Customer Secret Keys (generates an Access/Secret pair)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region identifier. Oracle example: ap-mumbai-1, us-ashburn-1, …  (use "auto" for R2)
AWS_REGION=
AWS_S3_BUCKET=synapse-media
S3_PRESIGNED_EXPIRATION=3600
# Provider endpoint. Leave EMPTY for real AWS. Examples:
#   Oracle: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
#   R2:     https://<account_id>.r2.cloudflarestorage.com
#   MinIO:  http://localhost:9000
S3_ENDPOINT_URL=
# Public base for serving objects to the browser.
#   - R2/Oracle/S3 (reachable): leave EMPTY → the API presigns GET URLs.
#   - MinIO on the box (port not public): set to the API's /media proxy, e.g.
#       https://<your-public-api-host>/api/v1/media
S3_PUBLIC_BASE_URL=

# ── Embedder ────────────────────────────────────────────────────────
# EMBED_BACKEND: local = run model in this container; hf = call HF Space; hybrid = text local, rest remote
EMBED_BACKEND=local
HF_SPACE_URL=
# MODEL_DEVICE: cpu | cuda | cuda:0
MODEL_DEVICE=cpu
BATCH_SIZE=32
EMBEDDING_DIM=1024
USE_REAL_MODEL=true
# fp16 autocast on CUDA so ImageBind-Huge fits an 8 GB card. Ignored on CPU.
MODEL_FP16=true

# ── Filesystem (paths inside containers) ────────────────────────────
UPLOAD_DIR=/app/data/uploads
EMBEDDINGS_DIR=/app/data/embeddings

# ── Pipeline switches ───────────────────────────────────────────────
UPLOAD_DIRECT_TO_QDRANT=true
